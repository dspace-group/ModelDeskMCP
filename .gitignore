# Python runtime and packaging
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.venv/
venv/
ENV/
.venv*/
.env
.python-version

# Build and distribution output
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test, lint, and coverage artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Local/private working state
*.jsonl
*.sqlite
*.db
cache/
.caches/
private/
private*/
.generated/
.generated*/

# Local editor and OS state
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Publishable public docs
!docs/*.md
!docs/**/*.md
/docs/public/

# Logs and temporary files
*.log
*.tmp
*.bak
.tmp-*/
/.specs

# Private automation and evidence; the ModelDesk product skill stays public.
/.agent-runtime/
/.github/agents/
/.github/tools/
/.github/skills/*
!/.github/skills/modeldesk-mcp-tools/
/.github/.preference.ini
/.github/.learnings.json
/.github/decisions.md
/.github/graph.json
/.github/graph.html
/.github/graph.json.lock
/.cursor/
/.claude/
/Framework/
/docs/live-modeldesk-qa.md
/problems.md

# Personal connections and credential material must not enter publication.
**/mcp.json
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
